NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 이메일 인증 후 돌아올 신뢰할 수 있는 앱 원점. 서버 전용.
# 로컬 개발 시 http://localhost:3000, Preview 테스트 시 해당 배포 주소로 변경합니다.
SITE_URL=https://alkkagi-alpha.vercel.app
# 후속 방/게임 서버 구현용. 현재 인증 기능에는 사용하지 않습니다.
